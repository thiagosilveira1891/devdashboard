# ============================================================
# Developer Dashboard — variables de entorno
# Copia este archivo a .env y rellena lo que necesites.
# Para desarrollar NO necesitas nada: sin DATABASE_URL la app
# arranca en modo demo con datos seed (cero API keys).
# ============================================================

# --- Modo demo ---
# Fuerza el modo demo aunque haya base de datos configurada.
DEMO_MODE=true

# --- Base de datos (PostgreSQL — Neon recomendado) ---
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth.js (login con GitHub) ---
# Crea una OAuth App en https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
# AUTH_SECRET="genera-uno-con: npx auth secret"
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# --- Cifrado de tokens OAuth en la base de datos (AES-256-GCM) ---
# 32 bytes en hex (64 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKEN_ENCRYPTION_KEY=""

# --- WakaTime OAuth ---
# Crea una app en https://wakatime.com/apps
# Callback URL: http://localhost:3000/api/auth/wakatime/callback
# WAKATIME_CLIENT_ID=""
# WAKATIME_CLIENT_SECRET=""

# --- Cron (protege /api/cron/sync en producción) ---
# CRON_SECRET=""
